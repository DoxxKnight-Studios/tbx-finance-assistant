DATABASE_URL=
PORT=3000

# AI Provider ("ollama" | "gemini") - defaults to "ollama"
AI_PROVIDER=ollama

# Ollama local settings (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite4.2:3b
OLLAMA_THINKING=low

# Gemini settings (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite